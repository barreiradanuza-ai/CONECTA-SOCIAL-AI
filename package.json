{
  "name": "conecta-social-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Conecta Social AI — gestor de redes sociais com IA para Facebook e Instagram",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "sh scripts/start.sh",
    "worker": "tsx src/worker/index.ts",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^6.16.0",
    "@resvg/resvg-js": "^2.6.2",
    "next": "^15.5.0",
    "prisma": "^6.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "satori": "^0.12.0",
    "sharp": "^0.34.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0"
  }
}
